{
  "name": "match-five",
  "version": "0.1.0",
  "private": true,
  "homepage": "/match-five",
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.7",
    "@types/node": "^16.18.68",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/react-redux": "^7.1.33",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^10.0.0",
    "ajv": "^8.12.0",
    "ajv-keywords": "^5.1.0",
    "bootstrap": "^5.3.2",
    "framer-motion": "^11.15.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.9.1",
    "react-dom": "^18.2.0",
    "react-ga4": "^2.1.0",
    "react-icons": "^4.12.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.21.0",
    "react-scripts": "5.0.1",
    "redux-persist": "^6.0.0",
    "typescript": "^4.9.5",
    "uuid": "^11.0.5",
    "web-vitals": "^2.1.4",
    "ts-node": "^10.9.2"
  },
  "scripts": {
    "start": "set PORT=3010 && react-scripts start",
    "build": "react-scripts build",
    "eject": "react-scripts eject",
    "generate-game-data": "node scripts/generateGameData.js",
    "test:data": "node scripts/generateGameData.test.js",
    "test:analytics": "node scripts/validateAnalytics.test.js",
    "test:persist": "node scripts/persistMigration.test.js",
    "test:daily:schema": "node scripts/daily/verify-boards.test.js --schema --quiet",
    "test:daily": "node scripts/daily/verify-boards.test.js && node scripts/daily/mutation.test.mjs",
    "test:daily:full": "node scripts/daily/verify-boards.test.js --full",
    "test": "npm run test:data && npm run test:analytics && npm run test:persist && npm run test:daily",
    "daily:key": "node scripts/daily/build-key.mjs",
    "daily:recall": "node scripts/daily/wordnet/recall.mjs",
    "daily:pool": "node scripts/daily/pool.mjs",
    "daily:calendar": "node scripts/daily/calendar.mjs",
    "daily:publish": "node scripts/daily/publish.mjs",
    "daily:golden": "node scripts/daily/build-golden.mjs",
    "daily:judge": "node scripts/daily/judge/run.mjs",
    "daily:review": "node scripts/daily/review/build-review.mjs",
    "postinstall": "npm run test:data && npm run test:analytics && npm run test:persist && npm run test:daily:schema"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
